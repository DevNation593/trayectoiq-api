generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model AdminAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  actorEmail  String   @map("actor_email")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  reason      String?
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  traceId     String?  @map("trace_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [actorUserId], references: [id], onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "admin_audit_created_idx")
  @@map("admin_audit_logs")
}

model AnalyticsEvent {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  anonymousId  String?  @map("anonymous_id")
  eventName    String   @map("event_name")
  eventVersion Int      @default(1) @map("event_version")
  properties   Json     @default("{}")
  occurredAt   DateTime @map("occurred_at") @db.Timestamptz(6)
  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  user         User?    @relation(fields: [userId], references: [id], onUpdate: NoAction)

  @@index([eventName, occurredAt], map: "analytics_events_name_time_idx")
  @@index([userId, occurredAt], map: "analytics_events_user_time_idx", where: raw("(user_id IS NOT NULL)"))
  @@map("analytics_events")
}

model AppConfig {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User?    @relation(fields: [updatedBy], references: [id], onUpdate: NoAction)

  @@map("app_config")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model AuthSession {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz(6)
  deviceLabel              String?   @map("device_label")
  platform                 String?
  appVersion               String?   @map("app_version")
  ipHash                   String?   @map("ip_hash")
  userAgentHash            String?   @map("user_agent_hash")
  expiresAt                DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedReason            String?   @map("revoked_reason")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt               DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "auth_sessions_user_idx")
  @@map("auth_sessions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model DataExport {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String           @map("user_id") @db.Uuid
  status      DataExportStatus @default(PENDING)
  storageKey  String?          @map("storage_key")
  errorCode   String?          @map("error_code")
  requestedAt DateTime         @default(now()) @map("requested_at") @db.Timestamptz(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  expiresAt   DateTime?        @map("expires_at") @db.Timestamptz(6)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, requestedAt(sort: Desc)], map: "data_exports_user_idx")
  @@map("data_exports")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model EmailVerificationCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, createdAt(sort: Desc)], map: "email_verification_codes_user_idx")
  @@map("email_verification_codes")
}

model ExperimentAssignment {
  userId        String   @map("user_id") @db.Uuid
  experimentKey String   @map("experiment_key")
  variant       String
  assignedAt    DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, experimentKey])
  @@map("experiment_assignments")
}

model FeatureFlag {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @map("updated_by") @db.Uuid
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User?    @relation(fields: [updatedBy], references: [id], onUpdate: NoAction)

  @@map("feature_flags")
}

model IdempotencyKey {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  scope          String
  idempotencyKey String   @map("idempotency_key")
  requestHash    String   @map("request_hash")
  responseStatus Int?     @map("response_status")
  responseBody   Json?    @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, scope, idempotencyKey])
  @@index([expiresAt], map: "idempotency_keys_expiry_idx")
  @@map("idempotency_keys")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model MaintenanceItem {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  costProfileId      String             @map("cost_profile_id") @db.Uuid
  name               String
  cost               Decimal            @db.Decimal(18, 6)
  intervalKm         Decimal            @map("interval_km") @db.Decimal(18, 6)
  enabled            Boolean            @default(true)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  vehicleCostProfile VehicleCostProfile @relation(fields: [costProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([costProfileId], map: "maintenance_items_profile_idx")
  @@map("maintenance_items")
}

model OauthIdentity {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  provider        OauthProvider
  providerSubject String        @map("provider_subject")
  emailAtProvider String?       @map("email_at_provider")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerSubject])
  @@map("oauth_identities")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("password_reset_tokens")
}

model QuoteCostBreakdown {
  quoteId                  String   @id @map("quote_id") @db.Uuid
  fuelCost                 Decimal  @map("fuel_cost") @db.Decimal(24, 10)
  maintenanceCost          Decimal  @map("maintenance_cost") @db.Decimal(24, 10)
  tireCost                 Decimal  @map("tire_cost") @db.Decimal(24, 10)
  depreciationCost         Decimal  @map("depreciation_cost") @db.Decimal(24, 10)
  fixedCost                Decimal  @map("fixed_cost") @db.Decimal(24, 10)
  tollsCost                Decimal  @map("tolls_cost") @db.Decimal(24, 10)
  parkingCost              Decimal  @map("parking_cost") @db.Decimal(24, 10)
  otherCost                Decimal  @map("other_cost") @db.Decimal(24, 10)
  driverTargetCompensation Decimal  @map("driver_target_compensation") @db.Decimal(24, 10)
  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  quote                    Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("quote_cost_breakdowns")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model QuoteDecision {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quoteId    String             @unique @map("quote_id") @db.Uuid
  action     RealDecisionAction
  finalPrice Decimal?           @map("final_price") @db.Decimal(18, 6)
  influence  InfluenceAnswer
  notes      String?
  decidedAt  DateTime           @default(now()) @map("decided_at") @db.Timestamptz(6)
  updatedAt  DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  quote      Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("quote_decisions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model QuoteUsageCounter {
  userId    String   @map("user_id") @db.Uuid
  periodKey String   @map("period_key")
  used      Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, periodKey])
  @@map("quote_usage_counters")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Quote {
  id                     String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String                       @map("user_id") @db.Uuid
  vehicleId              String                       @map("vehicle_id") @db.Uuid
  quoteRequestId         String                       @unique @map("quote_request_id") @db.Uuid
  pricingEngineVersion   String                       @map("pricing_engine_version")
  routingProvider        String                       @map("routing_provider")
  routingProfile         String                       @map("routing_profile")
  returnMode             String                       @default("SYMMETRIC_ESTIMATE") @map("return_mode")
  currency               String                       @default("USD") @db.Char(3)
  pricingInputSnapshot   Json                         @map("pricing_input_snapshot")
  pickupLat              Decimal?                     @map("pickup_lat") @db.Decimal(10, 7)
  pickupLng              Decimal?                     @map("pickup_lng") @db.Decimal(10, 7)
  destinationLat         Decimal?                     @map("destination_lat") @db.Decimal(10, 7)
  destinationLng         Decimal?                     @map("destination_lng") @db.Decimal(10, 7)
  pickupLabel            String?                      @map("pickup_label")
  destinationLabel       String?                      @map("destination_label")
  exactLocationExpiresAt DateTime?                    @map("exact_location_expires_at") @db.Timestamptz(6)
  pickupDistanceMeters   Int                          @default(0) @map("pickup_distance_meters")
  pickupDurationSeconds  Int                          @default(0) @map("pickup_duration_seconds")
  tripDistanceMeters     Int                          @map("trip_distance_meters")
  tripDurationSeconds    Int                          @map("trip_duration_seconds")
  waitingSeconds         Int                          @default(0) @map("waiting_seconds")
  emptyReturnProbability Decimal                      @map("empty_return_probability") @db.Decimal(9, 6)
  offeredPrice           Decimal?                     @map("offered_price") @db.Decimal(18, 6)
  tollsAmount            Decimal                      @default(0) @map("tolls_amount") @db.Decimal(18, 6)
  parkingAmount          Decimal                      @default(0) @map("parking_amount") @db.Decimal(18, 6)
  otherDirectCostAmount  Decimal                      @default(0) @map("other_direct_cost_amount") @db.Decimal(18, 6)
  operatingCostRaw       Decimal                      @map("operating_cost_raw") @db.Decimal(24, 10)
  floorPriceRaw          Decimal                      @map("floor_price_raw") @db.Decimal(24, 10)
  minimumPriceRaw        Decimal                      @map("minimum_price_raw") @db.Decimal(24, 10)
  recommendedPriceRaw    Decimal                      @map("recommended_price_raw") @db.Decimal(24, 10)
  floorPrice             Decimal                      @map("floor_price") @db.Decimal(18, 2)
  minimumPrice           Decimal                      @map("minimum_price") @db.Decimal(18, 2)
  recommendedPrice       Decimal                      @map("recommended_price") @db.Decimal(18, 2)
  earningsPerHourRaw     Decimal?                     @map("earnings_per_hour_raw") @db.Decimal(24, 10)
  earningsPerKmRaw       Decimal?                     @map("earnings_per_km_raw") @db.Decimal(24, 10)
  recommendation         QuoteDecisionRecommendation?
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)
  quoteCostBreakdown     QuoteCostBreakdown?
  quoteDecision          QuoteDecision?
  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicle                Vehicle                      @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([exactLocationExpiresAt], map: "quotes_location_expiry_idx", where: raw("(exact_location_expires_at IS NOT NULL)"))
  @@index([userId, createdAt(sort: Desc)], map: "quotes_user_created_idx")
  @@map("quotes")
}

model SubscriptionTransaction {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId        String?              @map("subscription_id") @db.Uuid
  provider              SubscriptionProvider
  providerTransactionId String               @map("provider_transaction_id")
  eventType             String               @map("event_type")
  rawPayloadHash        String               @map("raw_payload_hash")
  occurredAt            DateTime             @map("occurred_at") @db.Timestamptz(6)
  processedAt           DateTime             @default(now()) @map("processed_at") @db.Timestamptz(6)
  subscription          Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerTransactionId, eventType])
  @@map("subscription_transactions")
}

model Subscription {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String                    @map("user_id") @db.Uuid
  provider                 SubscriptionProvider
  productId                String                    @map("product_id")
  providerSubscriptionId   String                    @map("provider_subscription_id")
  status                   SubscriptionStatus
  entitlementActive        Boolean                   @default(false) @map("entitlement_active")
  startsAt                 DateTime?                 @map("starts_at") @db.Timestamptz(6)
  currentPeriodEnd         DateTime?                 @map("current_period_end") @db.Timestamptz(6)
  updatedAt                DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  subscriptionTransactions SubscriptionTransaction[]
  user                     User                      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerSubscriptionId])
  @@index([userId], map: "subscriptions_user_idx")
  @@map("subscriptions")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model User {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String
  emailVerifiedAt        DateTime?               @map("email_verified_at") @db.Timestamptz(6)
  passwordHash           String?                 @map("password_hash")
  displayName            String?                 @map("display_name")
  role                   UserRole                @default(USER)
  countryCode            String                  @default("EC") @map("country_code") @db.Char(2)
  currency               String                  @default("USD") @db.Char(3)
  timezone               String                  @default("America/Guayaquil")
  analyticsOptOut        Boolean                 @default(false) @map("analytics_opt_out")
  status                 String                  @default("ACTIVE")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(6)
  adminAuditLogs         AdminAuditLog[]
  analyticsEvents        AnalyticsEvent[]
  appConfig              AppConfig[]
  authSessions           AuthSession[]
  dataExports            DataExport[]
  emailVerificationCodes EmailVerificationCode[]
  experimentAssignments  ExperimentAssignment[]
  featureFlags           FeatureFlag[]
  idempotencyKeys        IdempotencyKey[]
  oauthIdentities        OauthIdentity[]
  passwordResetTokens    PasswordResetToken[]
  quoteUsageCounters     QuoteUsageCounter[]
  quotes                 Quote[]
  subscriptions          Subscription[]
  vehicles               Vehicle[]

  @@map("users")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model VehicleCostProfile {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Tiene un indice unico parcial que vive solo en la migracion SQL (ver contract/db/schema.sql).
  vehicleId              String            @map("vehicle_id") @db.Uuid
  isActive               Boolean           @default(true) @map("is_active")
  fuelPricePerGallon     Decimal           @default(0) @map("fuel_price_per_gallon") @db.Decimal(18, 6)
  tireSetCost            Decimal           @default(0) @map("tire_set_cost") @db.Decimal(18, 6)
  tireUsefulLifeKm       Decimal?          @map("tire_useful_life_km") @db.Decimal(18, 6)
  monthlyFixedCost       Decimal           @default(0) @map("monthly_fixed_cost") @db.Decimal(18, 6)
  expectedMonthlyKm      Decimal?          @map("expected_monthly_km") @db.Decimal(18, 6)
  targetHourlyIncome     Decimal           @default(0) @map("target_hourly_income") @db.Decimal(18, 6)
  platformCommissionRate Decimal           @default(0) @map("platform_commission_rate") @db.Decimal(9, 6)
  paymentPercentageRate  Decimal           @default(0) @map("payment_percentage_rate") @db.Decimal(9, 6)
  paymentFixedFee        Decimal           @default(0) @map("payment_fixed_fee") @db.Decimal(18, 6)
  targetProfitMargin     Decimal           @default(0) @map("target_profit_margin") @db.Decimal(9, 6)
  createdAt              DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  maintenanceItems       MaintenanceItem[]
  vehicle                Vehicle           @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("vehicle_cost_profiles")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Vehicle {
  id                        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Tiene un indice unico parcial que vive solo en la migracion SQL (ver contract/db/schema.sql).
  userId                    String               @map("user_id") @db.Uuid
  type                      VehicleType
  brand                     String?
  model                     String?
  year                      Int?
  fuelType                  FuelType             @map("fuel_type")
  fuelEfficiencyKmPerGallon Decimal              @map("fuel_efficiency_km_per_gallon") @db.Decimal(18, 6)
  currentValue              Decimal              @default(0) @map("current_value") @db.Decimal(18, 6)
  expectedResidualValue     Decimal              @default(0) @map("expected_residual_value") @db.Decimal(18, 6)
  remainingUsefulLifeKm     Decimal?             @map("remaining_useful_life_km") @db.Decimal(18, 6)
  isDefault                 Boolean              @default(false) @map("is_default")
  archivedAt                DateTime?            @map("archived_at") @db.Timestamptz(6)
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @default(now()) @map("updated_at") @db.Timestamptz(6)
  quotes                    Quote[]
  vehicleCostProfiles       VehicleCostProfile[]
  user                      User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "vehicles_user_idx")
  @@map("vehicles")
}

enum DataExportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
  EXPIRED

  @@map("data_export_status")
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID

  @@map("fuel_type")
}

enum InfluenceAnswer {
  YES
  NO
  UNSURE

  @@map("influence_answer")
}

enum OauthProvider {
  GOOGLE
  APPLE

  @@map("oauth_provider")
}

enum QuoteDecisionRecommendation {
  ACCEPT
  NEGOTIATE
  REJECT

  @@map("quote_decision_recommendation")
}

enum RealDecisionAction {
  ACCEPTED_ORIGINAL_OFFER
  NEGOTIATED_AND_ACCEPTED
  REJECTED
  CANCELLED_BY_OTHER_PARTY
  UNKNOWN

  @@map("real_decision_action")
}

enum SubscriptionProvider {
  APPLE
  GOOGLE

  @@map("subscription_provider")
}

enum SubscriptionStatus {
  ACTIVE
  GRACE
  CANCELLED
  EXPIRED
  REFUNDED

  @@map("subscription_status")
}

enum UserRole {
  USER
  SUPPORT
  ADMIN

  @@map("user_role")
}

enum VehicleType {
  MOTORCYCLE
  CAR

  @@map("vehicle_type")
}
