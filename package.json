{
  "name": "trayectoiq-api",
  "version": "0.1.0",
  "private": true,
  "description": "API del MVP de TrayectoIQ",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "prisma generate",
    "build": "prisma generate && nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "nest start --watch --env-file .env",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.{mjs,ts}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm test:unit && pnpm test:golden",
    "test:unit": "vitest run test/unit/",
    "test:golden": "vitest run test/golden/ --passWithNoTests",
    "test:int": "vitest run test/integration/",
    "test:contract": "vitest run test/contract/ --passWithNoTests",
    "test:e2e": "vitest run test/e2e/",
    "openapi:lint": "redocly lint contract/openapi.yaml",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:check-schema": "vitest run test/integration/schema-drift.spec.ts",
    "contract:sync": "node scripts/sync-contract.mjs",
    "contract:check": "node scripts/sync-contract.mjs --check",
    "audit:deps": "pnpm audit --prod --audit-level=high",
    "ci:local": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:unit && pnpm test:golden && pnpm fixtures:check && pnpm openapi:lint && pnpm test:int && pnpm test:contract && pnpm test:e2e && pnpm audit:deps && pnpm build",
    "pricing:calc": "tsx scripts/pricing-calc.ts",
    "fixtures:check": "node scripts/check-fixtures.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.1.2",
    "@redocly/cli": "^2.62.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.2"
  }
}
