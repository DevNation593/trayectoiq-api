# Copiar a .env.test. Los tests de integracion crean y borran sus propias bases en este servidor.
NODE_ENV=test
PORT=3000
DATABASE_URL=postgresql://trayectoiq:trayectoiq@localhost:15432/trayectoiq
# Los tests de extremo a extremo corren en paralelo, cada archivo con su aplicacion y su pool:
# un pool pequeno evita agotar max_connections de PostgreSQL.
DATABASE_POOL_MAX=4

# Rutas y direcciones: docker compose --profile geo up -d
# ROUTING_PROVIDER=fake usa proveedores deterministas sin Valhalla ni Photon (no vale en produccion).
ROUTING_PROVIDER=fake
VALHALLA_URL=http://localhost:8002
PHOTON_URL=http://localhost:2322

# Secretos SOLO para desarrollo local. En staging y produccion salen del gestor de secretos.
JWT_ACCESS_SECRET=dev-only-access-secret-0123456789abcdef
JWT_REFRESH_PEPPER=dev-only-refresh-pepper-fedcba9876543210
PREVIEW_TOKEN_SECRET=dev-only-preview-token-secret-13579bdf

# Correo: Mailpit de docker-compose.yml (interfaz en http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=TrayectoIQ <no-reply@trayectoiq.local>

# Inicio con Google y Apple. Vacios = apagados. Lista separada por comas para Google.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_SIGNIN_AUDIENCE=
