# Copiar a .env para desarrollo local. Valores validos solo para el Postgres de docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://trayectoiq:trayectoiq@localhost:15432/trayectoiq

# Rutas y direcciones: docker compose --profile geo up -d
VALHALLA_URL=http://localhost:8002
PHOTON_URL=http://localhost:2322

# Secretos SOLO para desarrollo local. En staging y produccion salen del gestor de secretos.
JWT_ACCESS_SECRET=dev-only-access-secret-0123456789abcdef
JWT_REFRESH_PEPPER=dev-only-refresh-pepper-fedcba9876543210

# Correo: Mailpit de docker-compose.yml (interfaz en http://localhost:8025)
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=TrayectoIQ <no-reply@trayectoiq.local>
